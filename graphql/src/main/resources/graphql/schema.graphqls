 type User {
     id: ID!
     name: String!
     email: String
 }
 type Post {
     id: ID!
     title: String!
     content: String!
     author: User!
     comments: [Comment!]
 }
 type Comment {
     id: ID!
     content: String!
     author: User!
 }
    type Query {
        posts: [Post!]
        post(id: ID!): Post
    }